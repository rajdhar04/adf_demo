{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "raj-adf-practice-2026"
		},
		"LS_AzureSQL_RajPractice_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_RajPractice'"
		},
		"LS_AzureSQLDB_Source_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://rajadfstorage2026.dfs.core.windows.net/"
		},
		"LS_AzureSQL_RajPractice_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "raj-adf-practice-db.database.windows.net"
		},
		"LS_AzureSQL_RajPractice_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "raj_adf_practice_db"
		},
		"LS_AzureSQL_RajPractice_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "raj_sql_admin"
		},
		"TGR_EVENT_SIMPLE_properties_PL_FILE_EVENT_parameters_file_name": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"TGR_EVENT_SIMPLE_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/894fba2c-23bd-4a49-bc93-01dfd3b1239f/resourceGroups/raj_adf_practice/providers/Microsoft.Storage/storageAccounts/rajadfstorage2026"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "raj-adf-practice-2026_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureSQL_RajPractice_password": {
						"value": "[parameters('LS_AzureSQL_RajPractice_password')]"
					},
					"LS_AzureSQLDB_Source_properties_typeProperties_url": {
						"value": "[parameters('LS_AzureSQLDB_Source_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_RajPractice_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_RajPractice_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_RajPractice_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_RajPractice_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_RajPractice_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_RajPractice_properties_typeProperties_userName')]"
					},
					"TGR_EVENT_SIMPLE_properties_PL_FILE_EVENT_parameters_file_name": {
						"value": "[parameters('TGR_EVENT_SIMPLE_properties_PL_FILE_EVENT_parameters_file_name')]"
					},
					"TGR_EVENT_SIMPLE_properties_typeProperties_scope": {
						"value": "[parameters('TGR_EVENT_SIMPLE_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}